<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Compact Floating Bubble Pill -->
    <LinearLayout
        android:id="@+id/bubbleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_bubble"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/txtBubbleFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60 FPS"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/txtBubbleHz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90Hz"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Expanded Gaming HUD Panel -->
    <LinearLayout
        android:id="@+id/hudPanel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hud_panel"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="GAMEBOOST HUD"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnMinimizeHud"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_crop"
                    android:tint="#94A3B8"
                    android:contentDescription="Minimize" />

                <ImageView
                    android:id="@+id/btnCloseHud"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#FF3366"
                    android:contentDescription="Close" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Metric Rows -->
        <!-- Row 1: Real FPS vs Display Hz -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#181F2E"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GAME FPS"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPanelFps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60"
                    android:textColor="#00E676"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#181F2E"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISPLAY HZ"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPanelHz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="90Hz"
                    android:textColor="#00E5FF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- RAM Metric -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAM Usage:"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtPanelRam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="3.2GB / 6.0GB (53%)"
                android:textColor="#F1F5F9"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Temp Metric -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery Temp:"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtPanelTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="32.5°C"
                android:textColor="#F1F5F9"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Battery Metric -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery Level:"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtPanelBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="85%"
                android:textColor="#F1F5F9"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Force Kill Lag Button -->
        <Button
            android:id="@+id/btnQuickTrimRam"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#00E676"
            android:text="⚡ FORCE KILL LAG"
            android:textAllCaps="false"
            android:textColor="#090C10"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTrimResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
